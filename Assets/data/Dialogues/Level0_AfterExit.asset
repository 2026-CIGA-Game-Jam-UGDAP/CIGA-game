  m_Name: Level0_AfterExit
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u62C9\u5179"
    text: "\u6211\u521A\u521A\u5BF9\u8FD9\u91CC\u505A\u4E86\u4E00\u4E0B\u7B80\u5355\u7684\u4FA6\u67E5\uFF0C\u5728\u5730\u4E0B\u53D1\u73B0\u4E86\u4E24\u4E2A\u5907\u7528\u7684\u3001\u5168\u65B0\u7684\u55B7\u6C14\u80CC\u5305\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -391726316, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u65B9\u6CE2"
    text: "\u6240\u4EE5\u6211\u4EEC\u8981\u5148\u8FD9\u6837\uFF0C\u5C31\u80FD\u98DE\u8D77\u6765\u2026\u2026"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -1828046989, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u62C9\u5179"
    text: "\u4E0D\u8FC7\u8981\u5148\u4FDD\u8BC1\u6211\u4EEC\u6CA1\u6709\u5438\u9644\u5728\u5E73\u53F0\u4E0A\uFF0C\u5426\u5219\u80CC\u5305\u4E0D\u4F1A\u8D77\u4F5C\u7528\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -391726316, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u65B9\u6CE2"
    text: "\u4F60\u8FD8\u8BB0\u5F97\u600E\u4E48\u505A\u662F\u53D6\u6D88\u5438\u9644\u5427\uFF1F"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -1828046989, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName:
    text: "\u53EF\u4EE5\u7528WAD/\u5DE6\u4E0A\u53F3\u63A7\u5236\u55B7\u6C14\u80CC\u5305\u7684\u65B9\u5411\uFF01"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u5728\u4F7F\u7528\u80CC\u5305\u524D\uFF0C\u8BB0\u5F97\u8981\u89E3\u9664\u81EA\u8EAB\u7684\u5438\u9644\u54E6\uFF01"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  useTypingEffect: 1
  useAnimation: 0
  needsCG: 0
