  m_Script: {fileID: 11500000, guid: c0c70052bc13ae44f83abca1f1328c1a, type: 3}
  m_Name: Ending_Success
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u65B9\u6CE2"
    text: "\u6700\u540E\u4E00\u4E2A\u90E8\u5206\u88C5\u4E0A\u540E\u2026\u2026"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -1828046989, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u65B9\u6CE2"
    text: "\u8FD9\u6837\u5C31\u5927\u529F\u544A\u6210\u4E86\uFF01"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -1828046989, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u62C9\u5179"
    text: "\u5F15\u64CE\u3001\u63A8\u8FDB\u5668\u3001\u4EEA\u8868\u76D8\u2026\u2026\u90FD\u6CA1\u95EE\u9898\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -391726316, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u62C9\u5179"
    text: "\u603B\u4E4B\u6211\u4EEC\u8FD8\u7B97\u5E78\u8FD0\u3002\u8BD5\u7740\u53D1\u52A8\u5B83\u5427\u3002\u8D81\u7740\u9668\u77F3\u8FD8\u6CA1\u628A\u98DE\u8239\u518D\u6B21\u7838\u574F\u2026\u2026"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -391726316, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u65B9\u6CE2"
    text: "\u62C9\u5179\uFF1F"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -1828046989, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u62C9\u5179"
    text: "\u5E72\u561B\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -391726316, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName: "\u65B9\u6CE2"
    text: "\u548C\u4F60\u4E00\u8D77\u5192\u9669\u771F\u6709\u8DA3\uFF01"
    portrait: {fileID: 0}
    bigPortrait: {fileID: -1828046989, guid: dcb5a4ef03042bf408b1c650d671b958, type: 3}
  - speakerName:
    text: "\u8FD8\u6CA1\u7B49\u62C9\u5179\u56DE\u590D\uFF0C\u65B9\u6CE2\u5C31\u731B\u5730\u62C9\u4E0B\u63A8\u52A8\u5668\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u9EC4\u8272\u7684\u98DE\u8239\u50CF\u662F\u8981\u6563\u67B6\u4E86\u4F3C\u7684\u98A4\u6296\uFF0C\u968F\u540E\u201C\u8F70\u9686\u201D\u4E00\u58F0\u5410\u51FA\u9ED1\u70DF\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u521A\u4FEE\u597D\u7684\u98DE\u8239\u50CF\u88AB\u4E00\u811A\u8E39\u4E86\u51FA\u53BB\uFF0C\u5728\u5B87\u5B99\u91CC\u5212\u51FA\u6B6A\u6B6A\u626D\u626D\u7684\u7EBF\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u7A81\u7136\u7206\u53D1\u7684\u52A0\u901F\u5EA6\u4F7F\u5F97\u4ED6\u4EEC\u88AB\u60EF\u6027\u6B7B\u6B7B\u538B\u5728\u5EA7\u6905\u4E0A\uFF0C\u62C9\u5179\u611F\u89C9\u81EA\u5DF1\u7684\u5934\u5DFE\u90FD\u8981\u98DE\u8D70\u4E86\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u5B83\u8270\u96BE\u8F6C\u8FC7\u5934\uFF0C\u770B\u5411\u8EAB\u65C1\u8FB9\u52A0\u5927\u9A6C\u529B\u8FB9\u6B22\u547C\u7684\u65B9\u6CE2\uFF0C\u8138\u4E0A\u4E0D\u7981\u6EF4\u4E0B\u51B7\u6C57\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u56DB\u9762\u516B\u65B9\u6D8C\u6765\u7684\u5F57\u661F\u4E0E\u884C\u661F\u788E\u7247\u5212\u8FC7\u8237\u7A97\uFF0C\u7559\u4E0B\u65E0\u6570\u9053\u767D\u8272\u7684\u5212\u75D5\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u4E00\u5757\u5C16\u9510\u7684\u788E\u77F3\u8D34\u7740\u73BB\u7483\u64E6\u8FC7\u53BB\uFF0C\u53D1\u51FA\u4EE4\u4EBA\u7259\u9178\u7684\u6469\u64E6\u58F0\u3002\u8FD9\u4E9B\u75AF\u72C2\u7684\u5C0F\u4E1C\u897F\u5C06\u8981\u53BB\u649E\u51FB\u4EBA\u7C7B\u6587\u660E\u5728\u592A\u9633\u7CFB\u7684\u6700\u540E\u4E00\u70B9\u6B8B\u7559\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u5C31\u8FDE\u4E00\u8F86\u6C7D\u8F66\u7A7F\u8FC7\u5927\u6C14\u5C42\u6389\u5728\u5730\u7403\u4E0A\u90FD\u4F1A\u5F15\u53D1\u96BE\u4EE5\u60F3\u8C61\u7684\u707E\u96BE\u3002\u8FD9\u4E48\u8106\u5F31\uFF0C\u602A\u4E0D\u5F97\u4EBA\u7C7B\u6587\u660E\u51F6\u591A\u5409\u5C11\u5462\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u2026\u2026\u53EA\u4E0D\u8FC7\u73B0\u5728\u7684\u5B83\u4EEC\u4E5F\u6CA1\u6709\u5F88\u5B89\u5168\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u62C9\u5179\u6B7B\u6B7B\u6293\u7740\u5B89\u5168\u628A\u624B\uFF0C\u7948\u7977\u65B9\u6CE2\u6B64\u65F6\u4ECD\u65E7\u6E05\u9192\uFF0C\u7948\u7977\u521A\u63D0\u7684\u3001\u8FD8\u5728\u6389\u87BA\u4E1D\u7684\u98DE\u8239\uFF0C\u4E0D\u8981\u4E5F\u50CF\u5730\u7403\u4E00\u6837\u88AB\u7838\u51FA\u5927\u5927\u5C0F\u5C0F\u7684\u5751\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u65B9\u6CE2\u867D\u7136\u4ECD\u5728\u5174\u594B\u5730\u72C2\u98D9\uFF0C\u4F46\u7684\u786E\u6CA1\u5FD8\u6389\u76EE\u7684\u5730\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u98DE\u8239\u7684\u5C3E\u7130\u7529\u51FA\u53CD\u65B9\u5411\uFF0C\u8FD9\u8258\u642D\u8F7D\u7740\u4EBA\u7C7B\u667A\u6167\u7684\u5916\u661F\u822A\u8239\uFF0C\u4F1A\u4E00\u8DEF\u9A76\u51FA\u94F6\u6CB3\u7CFB\u3001\u4E00\u5934\u683D\u8FDB\u65E0\u540D\u7684\u661F\u4E91\uFF0C\u76F4\u5230\u56DE\u5230\u63A2\u9669\u5BB6\u6E29\u99A8\u7684\u6BCD\u661F\u3002"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u4ED6\u4EEC\u4F1A\u628A\u4EBA\u7C7B\u6587\u660E\u5E26\u56DE\u5230\u4EBA\u7C7B\u90FD\u672A\u66FE\u63A2\u7D22\u8FC7\u7684\u5730\u65B9\u2026\u2026"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u4E0D\u8FC7\u2014\u2014\u8BDD\u8BF4\u56DE\u6765\uFF0C\u5B83\u4EEC\u56DE\u53BB\u7684\u8DEF\u4E0A\u4F1A\u4E00\u5E06\u98CE\u987A\u5417\uFF1F\u5B83\u4EEC\u53C8\u4F1A\u7ECF\u5386\u4EC0\u4E48\u5192\u9669\uFF1F"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  - speakerName:
    text: "\u6216\u8BB8\u53EA\u6709\u4F60\u624D\u77E5\u9053\u672A\u6765\u7684\u7B54\u6848\u4E86\u2026\u2026"
    portrait: {fileID: 0}
    bigPortrait: {fileID: 0}
  useTypingEffect: 1
  useAnimation: 0
  needsCG: 1
  onComplete:
    m_PersistentCalls:
      m_Calls: []
